# =================================================================
# SmogAssistant Environment Configuration
# =================================================================

# 1. Google Gemini API Key (Optional)
# If provided, powers dynamic Generative AI synthesis via Gemini 1.5 Flash.
# If omitted or exhausted, the system automatically uses the built-in deterministic heuristic engine.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. WAQI (World Air Quality Index) Ground-Station Token (Optional)
# If provided, connects directly to physical CPCB / EPA ground stations.
# If omitted, Open-Meteo Air Quality & Weather API is used automatically (requires ZERO keys).
# Get a free token instantly at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# 3. Port Configuration (Default: 3000)
PORT=3000
