# =================================================================
# SmogAssistant - Environment Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# =================================================================

# -----------------------------------------------------------------
# 1. Google Gemini Generative AI Configuration
# -----------------------------------------------------------------
# Powers dynamic generative reasoning using Google Gemini 3-Series models:
#   Waterfall: gemini-3.6-flash -> 3.5-flash -> 3.5-flash-lite -> 3.1-flash-lite -> 2.5-flash
# If omitted, exhausted, or quota-limited, the system falls back seamlessly
# to the built-in deterministic atmospheric heuristic engine (100% offline-capable).
# Obtain a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional client-side default key (can also be entered interactively in the web UI):
# NEXT_PUBLIC_GEMINI_API_KEY=

# -----------------------------------------------------------------
# 2. WAQI (World Air Quality Index) Ground-Station Token
# -----------------------------------------------------------------
# Connects directly to physical CPCB / EPA / EEA ground monitoring stations
# and enables real-time AQICN geospatial map tiles on the /map route.
# If omitted, Open-Meteo Air Quality & CAMS European Ensemble API is used
# automatically (requires ZERO API keys or registration).
# Obtain a free token instantly at: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# Optional client-side default token (can also be entered interactively in the web UI):
# NEXT_PUBLIC_WAQI_API_TOKEN=

# -----------------------------------------------------------------
# 3. Server & Container Network Configuration
# -----------------------------------------------------------------
# Local development default: 3000
# Google Cloud Run production default: 8080 (injected automatically by Cloud Run runtime)
PORT=3000

# -----------------------------------------------------------------
# 4. Next.js Standalone Build (Docker / CI)
# -----------------------------------------------------------------
# Set to 'true' in Dockerfile and CI environments to emit minimal standalone bundle.
# Leave unset or 'false' in local Windows/OneDrive dev to prevent filesystem locks.
OUTPUT_STANDALONE=false
